# Copy this file to .env and fill it in. .env stays on your laptop: never commit it.

# Deepgram: console.deepgram.com -> API Keys -> Create a New API Key. Flux listens and speaks.
DEEPGRAM_API_KEY=

# Anthropic: console.anthropic.com -> API Keys. Claude does the thinking.
ANTHROPIC_API_KEY=

# SpatialReal: app.spatialreal.ai -> Apps -> Create API Key. Copy the key and the App ID.
SPATIALREAL_API_KEY=
SPATIALREAL_APP_ID=
# app.spatialreal.ai/avatars/library -> hover an avatar -> copy icon.
SPATIALREAL_AVATAR_ID=

# Which character to run: the name of a file in prompts/, without .md.
# host-interview gets to know each guest; front-desk is a business example to adapt.
CHARACTER=host-interview

# front-desk: who the assistant works for, and what it should know. Write the facts plainly.
BUSINESS_NAME=
BUSINESS_FACTS=

# Restart the bot after changing anything in this file.

# Optional: any Deepgram Flux voice (flux-<name>-en).
# DEEPGRAM_VOICE=flux-brooke-en

# Only the page this bot serves may read its replies.
PIPECAT_ALLOWED_ORIGINS=http://localhost:7860
